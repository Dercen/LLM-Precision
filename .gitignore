# Virtual environments
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Model weights, dataset caches, quantized checkpoints (never commit). Anchored to the
# repo root: unanchored `models/` and `data/` also swallowed src/ptqbench/models and
# src/ptqbench/data, which were never committed.
/models/
/weights/
/checkpoints/
/data/
hf_cache/
*.safetensors
*.bin
*.pt
*.pth
*.gguf

# `ptq export-mlir` output. The .mlir text embeds every weight (opt-125m: 480 MB, over
# GitHub's 100 MB file limit), so only the JSON of the committed example is tracked.
/exports/*
!/exports/opt125m-rtn4-g128/
*.mlir
*.mlirbc

# Experiment outputs (results/*.jsonl are small and CAN be committed; large dumps are not)
results/**/*.pt
results/**/*.safetensors
results/**/*.log
results/logs/
results/slurm/
logs/
wandb/
outputs/

# Secrets
.env
*.token

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# LibreOffice lock files
.~lock.*#
